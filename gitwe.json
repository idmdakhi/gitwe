{
  "version": 1,
  "name": "classic",

  "baseBranches": [
    {
      "name": "main",
      "aliases": ["master"],
      "protected": true
    },
    {
      "name": "develop",
      "aliases": ["dev"],
      "base": "main",
      "protected": true
    }
  ],

  "branchTypes": [
    {
      "name": "feature",
      "aliases": ["feat", "ftr"],
      "base": "develop",
      "target": "develop",
      "prefix": "feature/"
    },
    {
      "name": "release",
      "aliases": ["rls", "rels"],
      "base": "develop",
      "target": ["main", "develop"],
      "prefix": "release/"
    },
    {
      "name": "hotfix",
      "aliases": ["hfix", "patch"],
      "base": "main",
      "target": ["main", "develop"],
      "prefix": "hotfix/"
    },
    {
      "name": "bugfix",
      "aliases": ["bug", "bfix"],
      "base": "main",
      "target": ["develop"],
      "prefix": "bugfix/"
    },
    {
      "name": "support",
      "aliases": ["lts"],
      "base": "main",
      "target": "",
      "prefix": "support/"
    }
  ],

  "cli": {
    "enabled": true,
    "interactive": true,
    "color": true,
    "aliases": {
      "fs": "finish feature",
      "rs": "release start",
      "hf": "hotfix start",
      "st": "status"
    }
  },

  "merge": {
    "strategy": "merge",
    "branchTypes": {
      "main": "merge",
      "develop": "merge",
      "feature": "squash",
      "release": ["merge", "rebase"],
      "hotfix": "default",
      "bugfix": "merge",
      "support": ["default", "merge"]
    },
    "deleteOnFinish": ["feature", "release", "hotfix", "bugfix"],
    "squash": { "branchTypes": ["feature"], "enabled": true, "default": false }
  },

  "hooks": {
    "enabled": true,
    "path": ".gitwe/hooks"
  },

  "remote": {
    "name": "origin",
    "autoPush": false,
    "autoFetch": true
  },

  "versioning": {
    "enabled": true,
    "tagPrefix": "v",
    "format": "{{tagPrefix}}{{version}}",
    "tag": ["release", "hotfix"],
    "branchTypes": {
      "version": ["release"],
      "major": [""],
      "minor": ["feature"],
      "patch": ["hotfix"],
      "metadata ": [""]
    },
    "annotated": true,
    "pushTags": false,
    "changelog": {
      "enabled": false,
      "path": "CHANGELOG.md"
    }
  }
}
