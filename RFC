## نمونه پیاده‌سازی Feature Start

```ts
export class FeatureServiceImpl {
  constructor(
    private git: Git,
    private config: GitFlowConfig,
  ) {}

  async start(name: string): Promise<void> {
    await this.git.checkout(this.config.develop);

    await this.git.createBranch(`${this.config.featurePrefix}${name}`);

    await this.git.checkout(`${this.config.featurePrefix}${name}`);
  }
}
```

