{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/config/**/*.json",
    "src/config/**/*.yaml",
    "src/config/**/*.yml",
    "src/config/**/*.sh"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
