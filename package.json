{
  "name": "gitwe",
  "version": "1.0.0",
  "description": "git workflow engine — git-flow is just one example workflow.",
  "license": "MIT",
  "author": "Mohammad Amanalikhani <idmdakhi@gmail.com>",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitwe": "dist/cli/index.js"
  },
  "keywords": [
    "git",
    "workflow",
    "branching",
    "git-flow",
    "cli",
    "automation"
  ],
  "engines": {
    "node": ">=20"
  },
  "man": [
    "docs/README.md",
    "docs/01-vision.md",
    "docs/02-core.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:copy-config": "copyfiles -u 2 \"src/config/**/*.{json,yaml,yml,js,sh}\" dist/config",
    "build": "npm run clean && npm run build:ts && npm run build:copy-config"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js",
      "require": "./dist/config/*.js",
      "default": "./dist/config/*.js"
    },
    "./config/*.yaml": {
      "import": "./dist/config/*.yaml",
      "require": "./dist/config/*.yaml",
      "default": "./dist/config/*.yaml"
    },
    "./config/*.json": {
      "import": "./dist/config/*.json",
      "require": "./dist/config/*.json",
      "default": "./dist/config/*.json"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#gitwe/*": "./src/*.js",
    "#tests/*": "./tests/*.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "docs": "docs",
    "examples": "examples",
    "src": "src",
    "tests": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idmdakhi/gitwe.git"
  },
  "bugs": {
    "url": "https://github.com/idmdakhi/gitwe/issues"
  },
  "homepage": "https://github.com/idmdakhi/gitwe#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^5.2.2",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  }
}
