{
  "name": "gitwe",
  "version": "0.23.3",
  "description": "gitwe — a configurable git workflow engine; git-flow is just one of its workflows.",
  "license": "MIT",
  "author": "Mohammad Amanalikhani <idmdakhi@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitwe": "dist/cli/index.js"
  },
  "keywords": [
    "git",
    "workflow",
    "workflow-engine",
    "branching",
    "git-we",
    "git-flow",
    "gitflow",
    "github-flow",
    "gitlab-flow",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli/index.js",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".gitwe",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idmdakhi/gitwe.git"
  },
  "bugs": {
    "url": "https://github.com/idmdakhi/gitwe/issues"
  },
  "homepage": "https://github.com/idmdakhi/gitwe#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.3.0"
  }
}
