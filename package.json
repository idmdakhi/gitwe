{
  "name": "gitwe",
  "version": "1.0.6",
  "description": "git workflow engine — git-flow is just one example workflow.",
  "license": "MIT",
  "author": "Mohammad Amanalikhani <idmdakhi@gmail.com>",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitwe": "dist/cli/index.js"
  },
  "keywords": [
    "git",
    "workflow",
    "branching",
    "git-flow",
    "cli",
    "automation"
  ],
  "engines": {
    "node": ">=20.x"
  },
  "man": [
    "docs/README.md",
    "docs/01-vision.md",
    "docs/02-core.md"
  ],
  "scripts": {
    "start": "node dist/cli/index.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "clean": "rmdir /s dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "imports": {
    "#gitwe/*": "./src/*.js",
    "#tests/*": "./src/*.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "docs": "docs",
    "examples": "examples",
    "src": "src",
    "tests": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idmdakhi/gitwe.git"
  },
  "bugs": {
    "url": "https://github.com/idmdakhi/gitwe/issues"
  },
  "homepage": "https://github.com/idmdakhi/gitwe#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.3.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "js-yaml": "^5.2.2",
    "simple-git": "^3.36.0",
    "zod": "^4.4.3"
  }
}
