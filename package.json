{
  "name": "gitwe",
  "version": "2.0.0",
  "description": "A pluggable, DDD-structured git workflow engine — git-flow is just one example workflow.",
  "license": "MIT",
  "author": "Mohammad Amanalikhani <idmdakhi@gmail.com>",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitwe": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "docs": "docs",
    "examples": "examples",
    "src": "src",
    "tests": "tests"
  },
  "scripts": {
    "start": "node dist/cli/index.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "clean": "rmdir /s dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "imports": {
    "#gitwe/*": "./src/*.js",
    "#tests/*": "./src/*.js"
  },
  "keywords": [
    "git",
    "workflow",
    "branching",
    "git-flow",
    "cli",
    "automation",
    "ddd",
    "clean-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/git-workflow-engine/gitwe.git"
  },
  "bugs": {
    "url": "https://github.com/git-workflow-engine/gitwe/issues"
  },
  "homepage": "https://github.com/git-workflow-engine/gitwe#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  }
}
