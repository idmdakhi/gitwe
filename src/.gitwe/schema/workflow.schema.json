{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["workflow", "types"],
  "properties": {
    "version": { "type": "integer" },
    "workflow": { "type": "string" },
    "description": { "type": "string" },
    "branches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "protected": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "pipelines": {
      "type": "object",
      "properties": {
        "start": { "type": "array", "items": { "type": "string" } },
        "finish": { "type": "array", "items": { "type": "string" } },
        "update": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["prefix", "base", "target"],
        "properties": {
          "prefix": { "type": "string" },
          "base": { "type": "string" },
          "target": {
            "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
          },
          "deleteAfterFinish": { "type": "boolean" },
          "bumpVersion": {
            "type": "string",
            "enum": ["none", "patch", "minor", "major", "semver"]
          },
          "allowSquash": { "type": "boolean" },
          "requireDescription": { "type": "boolean" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "tag": {
            "oneOf": [
              { "type": "boolean" },
              {
                "type": "object",
                "properties": {
                  "prefix": { "type": "string" },
                  "pattern": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          },
          "changelog": { "type": "boolean" },
          "notify": { "type": "array", "items": { "type": "string" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "mergeStrategy": {
            "type": "string",
            "enum": ["merge", "squash", "rebase"]
          },
          "downstreamStrategy": {
            "type": "string",
            "enum": ["merge", "rebase"]
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "commands": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "interactive": { "type": "boolean" },
        "autocomplete": { "type": "boolean" },
        "color": { "type": "boolean" },
        "emoji": { "type": "boolean" },
        "hooks": {
          "type": "object",
          "properties": {
            "preStart": { "type": "array", "items": { "type": "string" } },
            "preFinish": { "type": "array", "items": { "type": "string" } },
            "postFinish": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "versioning": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultBump": { "type": "string" },
        "tagPrefix": { "type": "string" },
        "format": { "type": "string" },
        "changelog": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" }
          },
          "additionalProperties": false
        },
        "annotated": { "type": "boolean" },
        "push": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["merge", "squash", "rebase"]
        },
        "deleteSource": { "type": "boolean" },
        "squash": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "default": { "type": "boolean" },
            "requireConventional": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "autoMerge": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "whenAllChecksPass": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "commit": {
      "type": "object",
      "properties": {
        "conventional": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "types": { "type": "array", "items": { "type": "string" } },
            "scopes": { "type": "boolean" },
            "requireBody": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "template": { "type": "string" }
      },
      "additionalProperties": false
    },
    "branchNaming": {
      "type": "object",
      "properties": {
        "case": {
          "type": "string",
          "enum": ["kebab-case", "snake_case", "camelCase"]
        },
        "maxLength": { "type": "integer" },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "prefixRequired": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "preStart": { "type": "array", "items": { "type": "string" } },
        "postStart": { "type": "array", "items": { "type": "string" } },
        "preFinish": { "type": "array", "items": { "type": "string" } },
        "postFinish": { "type": "array", "items": { "type": "string" } },
        "preCommit": { "type": "array", "items": { "type": "string" } },
        "prePush": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "remote": {
      "type": "object",
      "properties": {
        "remote": { "type": "string" },
        "autoPush": { "type": "boolean" },
        "autoPull": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "integrations": {
      "type": "object",
      "properties": {
        "jira": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "linkBranches": { "type": "boolean" },
            "requireTicketInBranch": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "github": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "autoPR": { "type": "boolean" },
            "labels": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
