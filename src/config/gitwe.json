{
  "version": 1,

  "workflow": "git-flow",
  "description": "GitWe workflow configuration - Enhanced with powerful CLI support",

  "branches": {
    "main": {
      "protected": true
    },
    "develop": {
      "protected": true
    },
    "staging": { "protected": true }
  },
  "pipelines": {
    "start": ["validate", "transition", "finalize"],
    "finish": ["validate", "transition", "post_transition", "finalize"],
    "update": ["validate", "transition"]
  },
  "types": {
    "feature": {
      "prefix": "feature/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true,
      "bumpVersion": "none",
      "allowSquash": true,
      "requireDescription": true,
      "labels": ["feature"]
    },
    "release": {
      "prefix": "release/",
      "base": "develop",
      "target": ["main", "develop"],
      "tag": true,
      "bumpVersion": "semver",
      "changelog": true,
      "notify": ["slack", "teams"]
    },
    "hotfix": {
      "prefix": "hotfix/",
      "base": "main",
      "target": ["main", "develop"],
      "tag": true,
      "bumpVersion": "patch",
      "labels": ["hot"]
    },
    "bugfix": {
      "prefix": "bugfix/",
      "base": "develop",
      "target": "develop",
      "labels": ["bug"]
    },
    "support": {
      "prefix": "support/",
      "base": "main",
      "target": "main",
      "tag": true,
      "bumpVersion": "patch",
      "labels": ["lts"]
    },
    "experiment": {
      "aliases": ["spike"],
      "prefix": "experiment/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true,
      "allowSquash": true
    },
    "integration": {
      "aliases": ["qa", "staging"],
      "prefix": "stage/",
      "base": "develop",
      "target": "main",
      "deleteAfterFinish": true
    }
  },

  "cli": {
    "enabled": true,
    "commands": {
      "start": {
        "feature": "gitwe start feature <name> [--desc <description>]",
        "release": "gitwe start release <version>",
        "hotfix": "gitwe start hotfix <issue-id>",
        "bugfix": "gitwe start bugfix <name>"
      },
      "finish": {
        "feature": "gitwe finish feature [--squash] [--no-delete]",
        "release": "gitwe finish release [--no-tag] [--changelog]",
        "hotfix": "gitwe finish hotfix"
      },
      "sync": "gitwe sync [--all] [--rebase]",
      "status": "gitwe status [--verbose]",
      "pr": "gitwe pr create [--draft] [--reviewers <users>]",
      "changelog": "gitwe changelog --from <tag> --to <tag>",
      "version": "gitwe version bump [major|minor|patch]"
    },
    "aliases": {
      "fs": "finish feature",
      "rs": "release start",
      "hf": "hotfix",
      "st": "status",
      "sync": "sync"
    },
    "interactive": true,
    "autocomplete": true,
    "color": true,
    "emoji": true,
    "hooks": {
      "preStart": ["validate-branch-name", "check-uncommitted"],
      "preFinish": ["run-tests", "update-changelog"],
      "postFinish": ["notify-team"]
    }
  },

  "versioning": {
    "enabled": true,
    "defaultBump": "patch",
    "tagPrefix": "v",
    "format": "{{tagPrefix}}{{version}}",
    "changelog": {
      "enabled": true,
      "path": "CHANGELOG.md"
    },
    "annotated": true,
    "push": true
  },

  "merge": {
    "strategy": "merge",
    "deleteSource": true,
    "squash": {
      "enabled": true,
      "default": false,
      "requireConventional": true
    },
    "autoMerge": {
      "enabled": false,
      "whenAllChecksPass": true
    }
  },

  "commit": {
    "conventional": {
      "enabled": true,
      "types": ["feat", "fix", "chore", "refactor", "docs", "test", "style", "perf", "ci", "build"],
      "scopes": true,
      "requireBody": false
    },
    "template": "gitwe commit --template"
  },

  "branchNaming": {
    "case": "kebab-case",
    "maxLength": 80,
    "forbidden": ["main", "develop", "master", "production"],
    "prefixRequired": true
  },

  "hooks": {
    "enabled": true,
    "preStart": ["npm run lint"],
    "postStart": ["echo '🎉 Branch created!'"],
    "preFinish": ["npm run test", "npm run build"],
    "postFinish": ["echo '✅ Branch finished!'"],
    "preCommit": ["conventional-commit", "lint-staged"],
    "prePush": ["test", "build"]
  },

  "remote": {
    "remote": "origin",
    "autoPush": false,
    "autoPull": false
  },

  "integrations": {
    "jira": {
      "enabled": true,
      "linkBranches": true,
      "requireTicketInBranch": false
    },
    "github": {
      "enabled": true,
      "autoPR": true,
      "labels": true
    }
  }
}
