{
  "version": 2,
  "workflow": "git-flow",
  "description": "GitWe workflow configuration - Enhanced with powerful CLI support",

  "branches": {
    "main": {
      "protected": true,
      "requiredReviews": 2,
      "requireStatusChecks": true,
      "statusCheckContexts": ["ci/build", "ci/test", "security/scan"]
    },
    "develop": {
      "protected": true,
      "requiredReviews": 1,
      "requireStatusChecks": true
    }
  },

  "types": {
    "feature": {
      "prefix": "feature/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true,
      "allowSquash": true,
      "requireDescription": true
    },

    "release": {
      "prefix": "release/",
      "base": "develop",
      "target": ["main", "develop"],
      "tag": true,
      "bumpVersion": "semver",
      "changelog": true,
      "notify": ["slack", "teams"]
    },

    "hotfix": {
      "prefix": "hotfix/",
      "base": "main",
      "target": ["main", "develop"],
      "deleteAfterFinish": true,
      "requireUrgent": true,
      "bumpVersion": "patch"
    },

    "bugfix": {
      "prefix": "bugfix/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true,
      "labels": ["bug"]
    },

    "chore": {
      "prefix": "chore/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true
    }
  },
  "cli": {
    "enabled": true,
    "commands": {
      "start": {
        "feature": "gitwe start feature <name> [--desc <description>]",
        "release": "gitwe start release <version>",
        "hotfix": "gitwe start hotfix <issue-id>",
        "bugfix": "gitwe start bugfix <name>"
      },
      "finish": {
        "feature": "gitwe finish feature [--squash] [--no-delete]",
        "release": "gitwe finish release [--no-tag] [--changelog]",
        "hotfix": "gitwe finish hotfix"
      },
      "sync": "gitwe sync [--all] [--rebase]",
      "status": "gitwe status [--verbose]",
      "pr": "gitwe pr create [--draft] [--reviewers <users>]",
      "changelog": "gitwe changelog --from <tag> --to <tag>",
      "version": "gitwe version bump [major|minor|patch]"
    },
    "aliases": {
      "fs": "finish feature",
      "rs": "release start",
      "hf": "hotfix",
      "st": "status",
      "sync": "sync"
    },
    "interactive": true,
    "autocomplete": true,
    "color": true,
    "emoji": true,
    "hooks": {
      "preStart": ["validate-branch-name", "check-uncommitted"],
      "preFinish": ["run-tests", "update-changelog"],
      "postFinish": ["notify-team"]
    }
  },

  "merge": {
    "strategy": "merge",
    "deleteSource": true,
    "squash": {
      "enabled": true,
      "default": false,
      "requireConventional": true
    },
    "autoMerge": {
      "enabled": true,
      "whenAllChecksPass": true
    }
  },

  "tag": {
    "enabled": true,
    "prefix": "v",
    "annotated": true,
    "push": true,
    "format": "{{prefix}}{{version}}"
  },

  "commit": {
    "conventional": {
      "enabled": true,
      "types": ["feat", "fix", "chore", "refactor", "docs", "test", "style", "perf", "ci", "build"],
      "scopes": true,
      "requireBody": false
    },
    "template": "gitwe commit --template"
  },

  "branchNaming": {
    "case": "kebab-case",
    "maxLength": 80,
    "forbidden": ["main", "develop", "master", "production"],
    "prefixRequired": true
  },

  "hooks": {
    "enabled": true,
    "preCommit": ["conventional-commit", "lint-staged"],
    "prePush": ["test", "build"]
  },

  "integrations": {
    "jira": {
      "enabled": true,
      "linkBranches": true,
      "requireTicketInBranch": false
    },
    "github": {
      "enabled": true,
      "autoPR": true,
      "labels": true
    }
  }
}
