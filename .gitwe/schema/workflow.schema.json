{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["workflow", "types"],
  "properties": {
    "workflow": { "type": "string" },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["prefix", "base", "target"],
        "properties": {
          "prefix": { "type": "string" },
          "base": { "type": "string" },
          "target": {
            "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
          }
        }
      }
    }
  }
}
