{
  "version": 1,

  "workflow": "git-flow",

  "branches": {
    "main": {
      "protected": true
    },
    "develop": {
      "protected": true
    }
  },

  "types": {
    "feature": {
      "prefix": "feature/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true,
      "bumpVersion": "minor"
    },

    "release": {
      "prefix": "release/",
      "base": "develop",
      "target": ["main", "develop"],
      "tag": true,
      "bumpVersion": "major"
    },

    "hotfix": {
      "prefix": "hotfix/",
      "base": "main",
      "target": ["main", "develop"],
      "bumpVersion": "patch"
    }
  },

  "merge": {
    "strategy": "merge",
    "deleteSource": true,
    "bumpVersion": "minor"
  },

  "tag": {
    "enabled": true,
    "prefix": "v"
  },

  "commit": {
    "conventional": {
      "enabled": true
    }
  },

  "branchNaming": {
    "case": "kebab-case",
    "maxLength": 80
  },

  "hooks": {
    "preFinish": [],
    "postFinish": []
  },

  "remote": {
    "remote": "origin",
    "autoPush": false,
    "autoPull": false
  }
}
