{
  "version": 1,

  "workflow": "git-flow",

  "branches": {
    "main": {
      "protected": true
    },
    "develop": {
      "protected": true
    },
    "staging": { "protected": true }
  },
  "pipelines": {
    "start": ["validate", "transition", "finalize"],
    "finish": ["validate", "transition", "post_transition", "finalize"],
    "update": ["validate", "transition"]
  },
  "types": {
    "feature": {
      "prefix": "feature/",
      "base": "develop",
      "target": "develop",
      "deleteAfterFinish": true,
      "bumpVersion": "none"
    },
    "release": {
      "prefix": "release/",
      "base": "develop",
      "target": ["main", "develop"],
      "tag": true,
      "bumpVersion": "major"
    },
    "hotfix": {
      "prefix": "hotfix/",
      "base": "main",
      "target": ["main", "develop"],
      "tag": true,
      "bumpVersion": "patch"
    }
  },

  "versioning": {
    "enabled": true,
    "defaultBump": "patch",
    "tagPrefix": "v",
    "changelog": {
      "enabled": true,
      "path": "CHANGELOG.md"
    }
  },

  "merge": {
    "strategy": "merge",
    "deleteSource": true
  },

  "commit": {
    "conventional": {
      "enabled": true
    }
  },

  "branchNaming": {
    "case": "kebab-case",
    "maxLength": 80
  },

  "hooks": {
    "preStart": ["npm run lint"],
    "postStart": ["echo '🎉 Branch created!'"],
    "preFinish": ["npm run test", "npm run build"],
    "postFinish": ["echo '✅ Branch finished!'"]
  },

  "remote": {
    "remote": "origin",
    "autoPush": false,
    "autoPull": false
  }
}
