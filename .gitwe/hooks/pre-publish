#!/bin/bash
# .gitwe/hooks/pre-publish
# اطمینان از اینکه remote مورد نظر وجود دارد

REMOTE="${GITWE_REMOTE:-origin}"

echo "🔍 Checking remote '$REMOTE'..."

if ! git remote get-url "$REMOTE" >/dev/null 2>&1; then
  echo "❌ Remote '$REMOTE' does not exist!"
  exit 1
fi

echo "✅ Remote '$REMOTE' exists"
exit 0
