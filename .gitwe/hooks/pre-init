#!/usr/bin/env node
// .gitwe/hooks/pre-init
// اعتبارسنجی preset انتخاب‌شده

const data = JSON.parse(require("fs").readFileSync(0, "utf8"));

const preset = data.extra?.preset;
const allowed = ["classic", "github", "gitlab"];

if (preset && !allowed.includes(preset)) {
  console.error(`❌ Invalid preset: ${preset}`);
  console.error(`   Allowed: ${allowed.join(", ")}`);
  process.exit(1);
}

console.log(`✅ Preset validated: ${preset || "default"}`);
process.exit(0);
