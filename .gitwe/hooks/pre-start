#!/bin/bash
# .gitwe/hooks/pre-start
# بررسی می‌کند که آیا شاخه‌ای با نام مشابه وجود دارد

echo "🔍 Checking if branch '$GITWE_BRANCH' already exists..."

if git show-ref --verify --quiet "refs/heads/$GITWE_BRANCH"; then
  echo "❌ Branch '$GITWE_BRANCH' already exists!"
  exit 1
fi

echo "✅ Branch name is available"
exit 0
